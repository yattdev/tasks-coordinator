# Copy to ~/.config/kandev/coordinator.env and chmod 600. Never commit the real file.

# KanDev External MCP endpoint (streamable HTTP) — verify path in docs/features.md
MCP_URL="http://board.sfl:38429/mcp"

# The Coordinator task's own id (known after creating the task)
TASK_ID="00000000-0000-0000-0000-000000000000"

# Bearer token if the MCP endpoint requires auth; leave empty otherwise
MCP_TOKEN=""
